{
  "name": "Employee",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "title": "Nome Completo"
    },
    "cpf": {
      "type": "string",
      "title": "CPF"
    },
    "role": {
      "type": "string",
      "title": "Cargo"
    },
    "department": {
      "type": "string",
      "title": "Departamento",
      "enum": [
        "Administra\u00e7\u00e3o",
        "Financeiro",
        "RH",
        "TI",
        "Opera\u00e7\u00f5es",
        "Comercial",
        "Marketing",
        "Log\u00edstica",
        "Outro"
      ]
    },
    "phone": {
      "type": "string",
      "title": "Telefone"
    },
    "email": {
      "type": "string",
      "title": "E-mail"
    },
    "hire_date": {
      "type": "string",
      "format": "date",
      "title": "Data de Admiss\u00e3o"
    },
    "signature_url": {
      "type": "string",
      "title": "Assinatura"
    },
    "photo_url": {
      "type": "string",
      "title": "Foto"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Ativo",
        "Inativo",
        "Afastado"
      ],
      "default": "Ativo"
    }
  },
  "required": [
    "full_name",
    "role",
    "department"
  ]
}