{
  "name": "Event",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Nome do Evento"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Data"
    },
    "location": {
      "type": "string",
      "title": "Local"
    },
    "description": {
      "type": "string",
      "title": "Descri\u00e7\u00e3o"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Planejado",
        "Em Andamento",
        "Conclu\u00eddo",
        "Cancelado"
      ],
      "default": "Planejado"
    },
    "employees": {
      "type": "array",
      "title": "Funcion\u00e1rios",
      "items": {
        "type": "string"
      }
    },
    "team_confirmed": {
      "type": "boolean",
      "title": "Equipe Confirmada",
      "default": false
    }
  },
  "required": [
    "name",
    "date"
  ]
}