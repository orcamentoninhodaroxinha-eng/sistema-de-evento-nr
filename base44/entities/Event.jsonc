{
  "name": "Event",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Nome do Evento"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Data"
    },
    "location": {
      "type": "string",
      "title": "Local"
    },
    "description": {
      "type": "string",
      "title": "Descri\u00e7\u00e3o"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "Planejado",
        "Em Andamento",
        "Conclu\u00eddo",
        "Cancelado"
      ],
      "default": "Planejado"
    },
    "ceremony_start": {
      "type": "string",
      "title": "Hora de In\u00edcio da Cerim\u00f4nia"
    },
    "ceremony_end": {
      "type": "string",
      "title": "Hora de T\u00e9rmino da Cerim\u00f4nia"
    },
    "party_start": {
      "type": "string",
      "title": "Hora de In\u00edcio da Festa"
    },
    "party_end": {
      "type": "string",
      "title": "Hora de T\u00e9rmino da Festa"
    },
    "after_start": {
      "type": "string",
      "title": "Hora de In\u00edcio do After"
    },
    "after_end": {
      "type": "string",
      "title": "Hora de T\u00e9rmino do After"
    },
    "guest_count": {
      "type": "number",
      "title": "Quantidade de Convidados"
    },
    "sale_value": {
      "type": "string",
      "title": "Valor de Venda do Evento (admin)"
    },
    "employees": {
      "type": "array",
      "title": "Funcion\u00e1rios",
      "items": {
        "type": "string"
      }
    },
    "team_confirmed": {
      "type": "boolean",
      "title": "Equipe Confirmada",
      "default": false
    },
    "scale_pdf_url": {
      "type": "string",
      "title": "PDF da Escala"
    },
    "scale_csv_url": {
      "type": "string",
      "title": "Excel da Escala da Cozinha"
    },
    "scale_submitted": {
      "type": "boolean",
      "title": "Escala Cozinha Enviada para Aprova\u00e7\u00e3o",
      "default": false
    },
    "scale_approved": {
      "type": "boolean",
      "title": "Escala Cozinha Aprovada",
      "default": false
    },
    "scale_rejected": {
      "type": "boolean",
      "title": "Escala Cozinha Reprovada",
      "default": false
    },
    "scale_rejected_reason": {
      "type": "string",
      "title": "Motivo da Reprova\u00e7\u00e3o (Cozinha)"
    },
    "salao_csv_url": {
      "type": "string",
      "title": "Excel da Escala do Sal\u00e3o"
    },
    "salao_submitted": {
      "type": "boolean",
      "title": "Escala Sal\u00e3o Enviada para Aprova\u00e7\u00e3o",
      "default": false
    },
    "salao_approved": {
      "type": "boolean",
      "title": "Escala Sal\u00e3o Aprovada",
      "default": false
    },
    "salao_rejected": {
      "type": "boolean",
      "title": "Escala Sal\u00e3o Reprovada",
      "default": false
    },
    "salao_rejected_reason": {
      "type": "string",
      "title": "Motivo da Reprova\u00e7\u00e3o (Sal\u00e3o)"
    },
    "unified_scale_csv_url": {
      "type": "string",
      "title": "Excel da Escala Unificada"
    },
    "receipts_pdf_url": {
      "type": "string",
      "title": "PDF dos Recibos"
    }
  },
  "required": [
    "name",
    "date"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "aprovador"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "cozinha"
              }
            },
            {
              "data.status": {
                "$ne": "Conclu\u00eddo"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "salao"
              }
            },
            {
              "data.status": {
                "$ne": "Conclu\u00eddo"
              }
            }
          ]
        }
      ]
    },
    "update": null,
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}